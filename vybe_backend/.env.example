# Server
NODE_ENV=development
PORT=4000

# MongoDB — MUST be a replica set (even a single-node one) because phase 1 relies on
# multi-document transactions (user+stats creation, post create/delete + stats counters).
# Local dev: run `mongod --replSet rs0` once and `mongosh --eval "rs.initiate()"`.
# Atlas: replica sets are the default, no extra setup needed.
MONGO_URI=mongodb://127.0.0.1:27017/vybe?replicaSet=rs0

# CORS — comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=vybe-backend
JWT_AUDIENCE=vybe-app

# Google Sign-In
GOOGLE_CLIENT_ID=

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_WINDOW_MS=60000
GENERAL_RATE_LIMIT_MAX=120
# Tighter budget for endpoints that can carry a file upload (post create/edit,
# profile-photo) — bounds worst-case concurrent-upload memory pressure.
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30
# Chat message-send path — bounds how fast one user can write messages,
# independent of the per-message follow-gating check (who can be messaged).
CHAT_MESSAGE_RATE_LIMIT_WINDOW_MS=60000
CHAT_MESSAGE_RATE_LIMIT_MAX=60

# Account lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000

# S3 uploads (profile photos, post media) — credentials come from the AWS SDK's
# default provider chain (env vars AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or an
# IAM role in production), never hardcoded here. Without these two set, uploads
# fail with CredentialsProviderError (text-only posts/profile updates are
# unaffected — only requests that attach a file need these).
#
# IMPORTANT (infra, not code): objects are uploaded WITHOUT a public-read ACL —
# by default a new S3 bucket has Block Public Access enabled, so uploaded
# photos/media will 403 in a browser until you either (a) add a bucket policy
# allowing public s3:GetObject on the relevant prefixes (profile-photos/*,
# posts/*), or (b) front the bucket with CloudFront (Origin Access Control) and
# set S3_CDN_BASE_URL below. Decide this before going live — uploads will
# succeed either way, but images/videos won't render until one of these is set up.
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
# IAM user access key, scoped to this bucket only — see the IAM policy example
# from the S3 setup discussion (PutObject/DeleteObject/GetObject on
# profile-photos/* and posts/*, plus ListBucket on the bucket itself). Never
# use your AWS root account's keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN in front of the bucket; raw S3 URLs are used if left blank.
S3_CDN_BASE_URL=
IMAGE_MAX_BYTES=8388608
VIDEO_MAX_BYTES=52428800
